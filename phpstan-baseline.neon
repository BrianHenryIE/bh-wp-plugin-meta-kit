parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset non\-falsy\-string on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: development-plugin/class-mappings.php

		-
			message: '#^Access to constant ACTIVATED_TIME_OPTION_KEY on an unknown class BrianHenryIE\\Plugin_Meta_Kit\\Admin\\Activator\.$#'
			identifier: class.notFound
			count: 1
			path: src/admin/class-activation-admin-notice.php

		-
			message: '#^Found usage of constant DOING_AJAX\. Use wp_doing_ajax\(\) instead\.$#'
			identifier: phpstanWP.wpConstant.fetch
			count: 1
			path: src/admin/class-activation-admin-notice.php

		-
			message: '#^Parameter \#1 \$array of function array_pop expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/admin/class-activation-admin-notice.php

		-
			message: '#^Parameter \#1 \$option of function get_option expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/admin/class-activation-admin-notice.php

		-
			message: '#^Parameter \#1 \$value of function intval expects array\|bool\|float\|GMP\|int\|resource\|SimpleXMLElement\|string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/admin/class-activation-admin-notice.php

		-
			message: '#^Access to an undefined property BrianHenryIE\\Plugin_Meta_Kit\\Admin\\Dependencies_Notice\:\:\$api\.$#'
			identifier: property.notFound
			count: 1
			path: src/admin/class-dependencies-notice.php

		-
			message: '#^Cannot call method is_server_has_dependencies\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/admin/class-dependencies-notice.php

		-
			message: '#^Access to an undefined property object\:\:\$no_update\.$#'
			identifier: property.notFound
			count: 1
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Cannot access offset string on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Cannot access property \$name on mixed\.$#'
			identifier: property.nonObject
			count: 2
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Cannot access property \$sections on mixed\.$#'
			identifier: property.nonObject
			count: 2
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Cannot access property \$slug on mixed\.$#'
			identifier: property.nonObject
			count: 2
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Method BrianHenryIE\\Plugin_Meta_Kit\\Admin\\Plugins_Page_View_Details_Modal\:\:add_tabs\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Method BrianHenryIE\\Plugin_Meta_Kit\\Admin\\Plugins_Page_View_Details_Modal\:\:add_tabs\(\) has parameter \$res with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$result$#'
			identifier: parameter.notFound
			count: 1
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Variable \$args in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/admin/class-plugins-page-view-details-modal.php

		-
			message: '#^Parameter \#1 \$array of function array_reduce expects array\<string\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/bootstrap.php

		-
			message: '#^Parameter \#1 \$filename of function file_exists expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/bootstrap.php

		-
			message: '#^Parameter \#1 \$paths of static method Dotenv\\Dotenv\:\:createImmutable\(\) expects array\<string\>\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/bootstrap.php
